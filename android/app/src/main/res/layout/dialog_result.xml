<?xml version="1.0" encoding="utf-8"?>
<!-- 传送结果窗：成功与失败都用「色点 + 文字」，不用大色块 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/page_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dotResult"
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/tvResultTitle"
                style="@style/TextAppearance.NfcTap.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultBody"
            style="@style/TextAppearance.NfcTap.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:breakStrategy="simple"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnResultDone"
            style="@style/Widget.NfcTap.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="完成" />
    </LinearLayout>
</FrameLayout>
